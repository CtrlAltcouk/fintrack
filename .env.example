# Production deployments should load these values from /etc/outflow/outflow.env.
NODE_ENV=production
OUTFLOW_DB_PATH=/var/lib/outflow/outflow.db
OUTFLOW_APP_DIR=/opt/outflow/app
PORT=3000

# Automatic recurrence execution. Defaults are shown. Keep the interval long
# enough for the host and database; invalid combinations prevent startup.
RECURRENCE_RUNNER_ENABLED=true
RECURRENCE_RUNNER_INTERVAL_MS=60000
RECURRENCE_RUNNER_BATCH_SIZE=50
RECURRENCE_RUNNER_REQUEST_THROTTLE_MS=15000
RECURRENCE_RUNNER_RETRY_BASE_MS=60000
RECURRENCE_RUNNER_RETRY_MAX_MS=3600000
RECURRENCE_RUNNER_MAX_ATTEMPTS=5

# Absolute session lifetime. Invalid values, zero, negatives, and values above
# 720 hours prevent startup. The default is 12 hours.
OUTFLOW_SESSION_TTL_HOURS=12

# Number of explicitly trusted reverse-proxy hops. Leave at 0 when Outflow is
# reached directly. Set only to the known hop count in a controlled deployment.
OUTFLOW_TRUST_PROXY_HOPS=0

# Persisted login protection. Defaults are shown; invalid or internally
# inconsistent values prevent startup before the database is opened.
OUTFLOW_LOGIN_ACCOUNT_SHORT_MAX=5
OUTFLOW_LOGIN_ACCOUNT_SHORT_WINDOW_SECONDS=300
OUTFLOW_LOGIN_ACCOUNT_LONG_MAX=10
OUTFLOW_LOGIN_ACCOUNT_LONG_WINDOW_SECONDS=900
OUTFLOW_LOGIN_IP_MAX=30
OUTFLOW_LOGIN_IP_WINDOW_SECONDS=900
OUTFLOW_LOGIN_COOLDOWN_BASE_SECONDS=60
OUTFLOW_LOGIN_COOLDOWN_MAX_SECONDS=3600
OUTFLOW_LOGIN_CLAIM_TTL_SECONDS=30
OUTFLOW_LOGIN_MAX_USERNAME_LENGTH=100
OUTFLOW_LOGIN_MAX_PASSWORD_LENGTH=1024

# FINTRACK_DB_PATH remains supported as a legacy alias. Do not set both aliases
# unless they resolve to exactly the same database.
